# ---- Which engine and FHIR server? -------------------------------------------
# Swap components by changing this line, e.g. later:
#   COMPOSE_FILE=compose.yaml:stack/engine.waggle.yaml:stack/fhir.hapi.yaml
COMPOSE_FILE=compose.yaml:stack/engine.oie.yaml:stack/fhir.hapi.yaml

# ---- Images (pin to exact tags or digests once things work) ------------------
# The engine is built locally from engine/oie/Dockerfile (versions pinned there).
HAPI_IMAGE=hapiproject/hapi:latest

# ---- Simulated Hospital --------------------------------------------------------
HOSPITAL_TIMEZONE=America/Chicago
HOSPITAL_PATHWAYS_PER_HOUR=60
# deterministic = run HOSPITAL_PATHWAYS in order, repeating (reproducible corpus)
# distribution  = random pathways weighted by percentage (leave HOSPITAL_PATHWAYS empty)
HOSPITAL_PATHWAY_MANAGER=deterministic
HOSPITAL_PATHWAYS=lab_admit_discharge,lab_admit_transfer_discharge,lab_admit_cbc_discharge

# ---- Feed routing (message type = engine listener) ---------------------------
GATEWAY_ROUTES=ADT=engine:6661,ORM=engine:6662,ORU=engine:6663,MDM=engine:6664

# ---- Engine ----------------------------------------------------------------------
ENGINE_HEAP=768m
ENGINE_SERVER_ID=6f6e1b52-0c1e-4a57-9b43-1ab5f2c1e001
ENGINE_DB_PASSWORD=engine-lab
ENGINE_KEYSTORE_PASSWORD=keystore-lab

# ---- FHIR server ---------------------------------------------------------------
FHIR_DB_PASSWORD=hapi-lab
